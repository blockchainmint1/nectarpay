{
  "name": "nectarpay/craft-commerce",
  "description": "Non-custodial crypto payments (BTC, TEXITcoin, stablecoins) for Craft Commerce via NectarPay.",
  "type": "craft-plugin",
  "license": "MIT",
  "require": {
    "craftcms/cms": "^4.0 || ^5.0",
    "craftcms/commerce": "^4.0 || ^5.0"
  },
  "autoload": {
    "psr-4": {
      "nectarpay\\craftcommerce\\": "src/"
    }
  },
  "extra": {
    "handle": "nectarpay",
    "name": "NectarPay",
    "class": "nectarpay\\craftcommerce\\Plugin"
  }
}
