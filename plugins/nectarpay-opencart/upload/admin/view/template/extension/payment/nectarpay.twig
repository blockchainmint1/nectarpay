{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-payment" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading"><h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3></div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-payment" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-api-key"><span data-toggle="tooltip" title="{{ help_api_key }}">{{ entry_api_key }}</span></label>
            <div class="col-sm-10"><input type="password" name="payment_nectarpay_api_key" value="{{ payment_nectarpay_api_key }}" id="input-api-key" class="form-control" /></div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-webhook-secret"><span data-toggle="tooltip" title="{{ help_webhook_secret }}">{{ entry_webhook_secret }}</span></label>
            <div class="col-sm-10">
              <input type="password" name="payment_nectarpay_webhook_secret" value="{{ payment_nectarpay_webhook_secret }}" id="input-webhook-secret" class="form-control" />
              <p class="help-block">Webhook URL: <code>{{ webhook_url }}</code></p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-api-base">{{ entry_api_base }}</label>
            <div class="col-sm-10"><input type="text" name="payment_nectarpay_api_base" value="{{ payment_nectarpay_api_base }}" id="input-api-base" class="form-control" /></div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="payment_nectarpay_status" id="input-status" class="form-control">
                <option value="1" {% if payment_nectarpay_status %}selected="selected"{% endif %}>{{ text_enabled }}</option>
                <option value="0" {% if not payment_nectarpay_status %}selected="selected"{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-sort-order">{{ entry_sort_order }}</label>
            <div class="col-sm-10"><input type="text" name="payment_nectarpay_sort_order" value="{{ payment_nectarpay_sort_order }}" id="input-sort-order" class="form-control" /></div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
